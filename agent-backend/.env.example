# ==============================================================================
# DS-Body 智能体后端环境变量模板
# 使用方法：复制本文件为 .env，并在 DEEPSEEK_API_KEY 处填入你的真实密钥
# ==============================================================================

# 【必填】请将下方的占位符替换为你的 DeepSeek API 密钥（以 sk- 开头）
# 密钥申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-请在这里填入你的DeepSeek密钥

# DeepSeek API 基础地址（官方默认地址，一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 调用的模型名称（deepseek-chat 或 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat

# 生成随机度（0.0 ~ 2.0）
DEEPSEEK_TEMPERATURE=0.8

# 单个会话最多保留的历史对话轮数
MAX_HISTORY_ROUNDS=10

# 后端 HTTP 服务监听地址与端口
APP_HOST=127.0.0.1
APP_PORT=8000

# 允许跨域访问的前端页面地址（多个地址用英文逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
