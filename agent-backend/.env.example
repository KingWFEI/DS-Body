# ==============================================================================
# DS-Body 智能体后端环境变量模板
# 使用方法：复制本文件为 .env，并在 DEEPSEEK_API_KEY 处填入你的真实密钥
# ==============================================================================

# 【必填】请将下方的占位符替换为你的 DeepSeek API 密钥（以 sk- 开头）
# 密钥申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-请在这里填入你的DeepSeek密钥

# DeepSeek API 基础地址（官方默认地址，一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 调用的模型名称（deepseek-chat 或 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat

# 生成随机度（0.0 ~ 2.0）
DEEPSEEK_TEMPERATURE=0.8

# 单次喂给大模型的最大近期历史对话轮数（完整历史仍保存在本地 SQLite 中）
MAX_HISTORY_ROUNDS=10

# 本地 SQLite 记忆数据库文件路径（相对 agent-backend 目录，也可填绝对路径）
SQLITE_DB_PATH=data/pet_memory.sqlite

# 本地离线语音识别（faster-whisper）配置
# 可选模型大小：tiny | base | small（默认 base 兼顾速度与中文识别率；追求更高准确率可改 small）
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_DIR=data/whisper_models
# 国内网络加速下载 Whisper 权重的镜像站地址
HF_ENDPOINT=https://hf-mirror.com

# 后端 HTTP 服务监听地址与端口
APP_HOST=127.0.0.1
APP_PORT=8000

# 允许跨域访问的前端页面地址（多个地址用英文逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
